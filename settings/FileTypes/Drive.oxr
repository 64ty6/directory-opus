<?xml version="1.0" encoding="UTF-8"?>
<xml_registry_redirect hive="HKCR">
	<key name="Drive">
		<key name="opusflags">
			<value name="OpusDoneDefTiles" type="sz" />
			<value name="OpusDoneDefTooltip" type="sz" />
			<value name="OpusTilesDef" type="sz">{sh:usedpercent}
{sh:freespace} 可用，共 {sizeauto}</value>
			<value name="OpusTooltipDPI" type="sz">150</value>
			<value name="OpusTooltipDef" type="sz">&lt;b&gt;已用空间：&lt;/b&gt;\	{sh:usedspace}
&lt;b&gt;可用空间：&lt;/b&gt;\	{sh:freespace}
&lt;b&gt;空间总量：&lt;/b&gt;\	{sizeauto}</value>
		</key>
	</key>
</xml_registry_redirect>
